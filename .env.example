# Configuración del Servidor
PORT=3000
NODE_ENV=production

# Secreto para firma de sesiones y cookies (generar una cadena aleatoria segura en producción)
SESSION_SECRET=cambiar_este_secreto_por_uno_seguro_y_aleatorio_de_minimo_32_caracteres

# URL pública del sitio (usado para canonical URLs y sitemap)
SITE_URL=https://anabellazalazararquitecta.com.ar

# Credenciales iniciales para el primer setup (opcional, también se puede usar npm run setup-admin)
ADMIN_EMAIL=admin@anabellazalazararquitecta.com.ar
ADMIN_INITIAL_PASSWORD=DefinirPasswordSegura2026!
